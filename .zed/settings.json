{
  "code_actions_on_format": {
    "source.organizeImports.biome": true,
    "source.fixAll.biome": true
  },
  "formatter": {
      "external": {
        "command": "biome",
        "arguments": [
          "format",
          "--write",
          "--stdin-file-path={buffer_path}"
        ]
      }
    },
    "languages": {
      "Prisma": {
        "formatter": "language_server",
        "format_on_save": "on"
      }
    }
}
